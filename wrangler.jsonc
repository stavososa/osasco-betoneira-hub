{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tanstack-start-app",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "assets": {
    "binding": "ASSETS",
    // Without this, Cloudflare serves these paths straight from the edge,
    // bypassing src/server.ts entirely — so the security headers below never attach to them.
    "run_worker_first": ["/assets/*", "/favicon.png", "/robots.txt", "/sitemap.xsl", "/llms.txt"]
  }
}
